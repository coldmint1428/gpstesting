# Copy this file to .env and fill in your own values. Never commit .env.
# Supabase -> Project Settings -> API Keys (the public "publishable" or "anon" key, NEVER the secret/service key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public https address of the app, used in invite links / QR codes / WhatsApp & Telegram shares.
# Leave empty on a laptop (uses the current address). Set it to the Vercel link once deployed.
VITE_PUBLIC_APP_URL=
