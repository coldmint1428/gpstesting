# Copy this file to .env and fill in your own values. Never commit .env.
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Test IDs for the GPS sandbox (until we have real events/groups tables).
# Any valid UUIDs work; keep them the same across devices so readings group together.
VITE_TEST_EVENT_ID=00000000-0000-0000-0000-000000000001
VITE_TEST_GROUP_ID=00000000-0000-0000-0000-000000000001
